format 1;
device "M1/S";
design "counter";

pass synth "mica-synth 0.1";
pass techmap "mica-map 0.1";
pass pack "mica-pack 0.1";
pass place "mica-place 0.1";

net clk : clock;
net q[0..3];
net s[0..3];
net c[0..2];
net seg[0..6];

cell cnt0 : CARRY {
    LUT_P = 0x0F;
    LUT_G = 0x00;
    PACK = lsb;
    SLOT = LE1;
    SITE = (26, 37);

    in B = q[0];
    in CIN = 1;
    out S = s[0];
    out COUT = c[0];
}

cell ff0 : FF {
    PACK = lsb;
    SLOT = LE1;
    SITE = (26, 37);

    in CLK = clk;
    in D = s[0];
    in E = 1;
    out Q = q[0];
}

cell cnt1 : CARRY {
    LUT_P = 0x1E;
    LUT_G = 0x00;
    PACK = lsb;
    SLOT = LE2;
    SITE = (26, 37);

    in B = q[1];
    in C = q[0];
    in D = q[3];
    in CIN = c[0];
    out S = s[1];
    out COUT = c[1];
}

cell ff1 : FF {
    PACK = lsb;
    SLOT = LE2;
    SITE = (26, 37);

    in CLK = clk;
    in D = s[1];
    in E = 1;
    out Q = q[1];
}

cell cnt2 : CARRY {
    LUT_P = 0x36;
    LUT_G = 0x00;
    PACK = msb;
    SLOT = LE1;
    SITE = (27, 37);

    in B = q[0];
    in C = q[2];
    in D = q[3];
    in CIN = c[1];
    out S = s[2];
    out COUT = c[2];
}

cell ff2 : FF {
    PACK = msb;
    SLOT = LE1;
    SITE = (27, 37);

    in CLK = clk;
    in D = s[2];
    in E = 1;
    out Q = q[2];
}

cell cnt3 : CARRY {
    LUT_P = 0x0F;
    LUT_G = 0x00;
    PACK = msb;
    SLOT = LE2;
    SITE = (27, 37);

    in B = q[3];
    in CIN = c[2];
    out S = s[3];
}

cell ff3 : FF {
    PACK = msb;
    SLOT = LE2;
    SITE = (27, 37);

    in CLK = clk;
    in D = s[3];
    in E = 1;
    out Q = q[3];
}

cell rom : BRAM {
    WIDTH = 8;
    data {
        000: 77 24 5D 6D 2E 6B 7B 25;
        008: 7F 6F;
    }
    SITE = (25, 38);

    in ADDR[0..3] = q[0..3];
    in ADDR[4..8] = 0;
    out DO[0..6] = seg[0..6];
}

cell pad_a : IO {
    PIN = 200;
    SITE = (25, 0);

    in O = seg[0];
    in E = 1;
}

cell pad_b : IO {
    PIN = 161;
    SITE = (49, 16);

    in O = seg[1];
    in E = 1;
}

cell pad_c : IO {
    PIN = 16;
    SITE = (0, 16);

    in O = seg[2];
    in E = 1;
}

cell pad_d : IO {
    PIN = 32;
    SITE = (0, 32);

    in O = seg[3];
    in E = 1;
}

cell pad_e : IO {
    PIN = 129;
    SITE = (49, 48);

    in O = seg[4];
    in E = 1;
}

cell pad_f : IO {
    PIN = 48;
    SITE = (0, 48);

    in O = seg[5];
    in E = 1;
}

cell pad_g : IO {
    PIN = 90;
    SITE = (26, 65);

    in O = seg[6];
    in E = 1;
}

net clk : clock {
    CLK = 0;
    PIN = 1;
}
