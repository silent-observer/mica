format 1;
device "M1/S";
design "counter";

pass synth "mica-synth 0.1";
pass techmap "mica-map 0.1";
pass pack "mica-pack 0.1";
pass place "mica-place 0.1";
pass route "mica-route 0.1";

net clk : clock;
net q[0..3];
net s[0..3];
net c[0..2];
net seg[0..6];

cell cnt0 : CARRY {
    LUT_P = 0x0F;
    LUT_G = 0x00;
    PACK = lsb;
    SLOT = LE1;
    SITE = (26, 37);

    in B = q[0];
    in CIN = 1;
    out S = s[0];
    out COUT = c[0];
}

cell ff0 : FF {
    PACK = lsb;
    SLOT = LE1;
    SITE = (26, 37);

    in CLK = clk;
    in D = s[0];
    in E = 1;
    out Q = q[0];
}

cell cnt1 : CARRY {
    LUT_P = 0x1E;
    LUT_G = 0x00;
    PACK = lsb;
    SLOT = LE2;
    SITE = (26, 37);

    in B = q[1];
    in C = q[0];
    in D = q[3];
    in CIN = c[0];
    out S = s[1];
    out COUT = c[1];
}

cell ff1 : FF {
    PACK = lsb;
    SLOT = LE2;
    SITE = (26, 37);

    in CLK = clk;
    in D = s[1];
    in E = 1;
    out Q = q[1];
}

cell cnt2 : CARRY {
    LUT_P = 0x36;
    LUT_G = 0x00;
    PACK = msb;
    SLOT = LE1;
    SITE = (27, 37);

    in B = q[0];
    in C = q[2];
    in D = q[3];
    in CIN = c[1];
    out S = s[2];
    out COUT = c[2];
}

cell ff2 : FF {
    PACK = msb;
    SLOT = LE1;
    SITE = (27, 37);

    in CLK = clk;
    in D = s[2];
    in E = 1;
    out Q = q[2];
}

cell cnt3 : CARRY {
    LUT_P = 0x0F;
    LUT_G = 0x00;
    PACK = msb;
    SLOT = LE2;
    SITE = (27, 37);

    in B = q[3];
    in CIN = c[2];
    out S = s[3];
}

cell ff3 : FF {
    PACK = msb;
    SLOT = LE2;
    SITE = (27, 37);

    in CLK = clk;
    in D = s[3];
    in E = 1;
    out Q = q[3];
}

cell rom : BRAM {
    WIDTH = 8;
    data {
        000: 77 24 5D 6D 2E 6B 7B 25;
        008: 7F 6F;
    }
    SITE = (25, 38);

    in ADDR[0..3] = q[0..3];
    in ADDR[4..8] = 0;
    out DO[0..6] = seg[0..6];
}

cell pad_a : IO {
    PIN = 200;
    SITE = (25, 0);

    in O = seg[0];
    in E = 1;
}

cell pad_b : IO {
    PIN = 161;
    SITE = (49, 16);

    in O = seg[1];
    in E = 1;
}

cell pad_c : IO {
    PIN = 16;
    SITE = (0, 16);

    in O = seg[2];
    in E = 1;
}

cell pad_d : IO {
    PIN = 32;
    SITE = (0, 32);

    in O = seg[3];
    in E = 1;
}

cell pad_e : IO {
    PIN = 129;
    SITE = (49, 48);

    in O = seg[4];
    in E = 1;
}

cell pad_f : IO {
    PIN = 48;
    SITE = (0, 48);

    in O = seg[5];
    in E = 1;
}

cell pad_g : IO {
    PIN = 90;
    SITE = (26, 65);

    in O = seg[6];
    in E = 1;
}

net clk : clock {
    CLK = 0;
    PIN = 1;
}

net q[0] {
    route {
        logic (26, 37): in B1 = O1A;
        logic (26, 37): in C2 = O1A;
        switch (26, 37): S.L1[2] = NW.O1A;
        logic (27, 37): in B1 = E[D].L1[2];
        switch (25, 36): N.L1[2] = SE.O1A;
        switch (24, 36): E.L4[0] = S.L1[2];
        bram (25, 38): in A1[0] = H0[R].L4[0];
    }
}

net q[1] {
    route {
        logic (26, 37): in B2 = O2A;
        switch (25, 37): N.L1[3] = SW.O2A;
        switch (24, 37): E.L1[1] = S.L1[3];
        bram (25, 38): in A1[1] = H0[R].L1[1];
    }
}

net q[2] {
    route {
        logic (27, 37): in C1 = O1A;
        switch (27, 37): N.L4[0] = NW.O1A;
        bram (25, 38): in A1[2] = W0[U].L4[6];
    }
}

net q[3] {
    route {
        switch (26, 37): N.L1[3] = SW.O2A;
        logic (26, 37): in D2 = E[U].L1[3];
        logic (27, 37): in D1 = O2A;
        logic (27, 37): in B2 = O2A;
        switch (25, 37): N.L4[1] = S.L1[3];
        switch (21, 37): E.L1[2] = S.L4[1];
        switch (21, 38): S.L4[0] = W.L1[2];
        bram (25, 38): in A1[3] = E0[D].L4[2];
    }
}

net seg[0] {
    route {
        switch (24, 37): W.L1[3] = SE.DO[0];
        switch (24, 36): W.L4[1] = E.L1[3];
        switch (24, 32): W.L16[0] = E.L4[1];
        switch (24, 16): W.L16[0] = E.L16[0];
        switch (24, 0): S.L1[0] = E.L16[0];
        io (25, 0): in O = E[D].L1[0];
    }
}

net seg[1] {
    route {
        switch (24, 37): W.L1[4] = SE.DO[1];
        switch (24, 36): W.L16[0] = E.L1[4];
        switch (24, 20): S.L16[0] = E.L16[0];
        switch (40, 20): S.L4[0] = N.L16[0];
        switch (44, 20): S.L4[0] = N.L4[0];
        switch (48, 20): W.L16[0] = N.L4[0];
        io (49, 16): in O = N[L].L16[1];
    }
}

net seg[2] {
    route {
        switch (24, 37): N.L16[0] = SE.DO[2];
        switch (8, 37): W.L1[4] = S.L16[0];
        switch (8, 36): W.L16[0] = E.L1[4];
        switch (8, 20): N.L4[0] = E.L16[0];
        switch (4, 20): N.L4[0] = S.L4[0];
        switch (0, 20): W.L16[0] = S.L4[0];
        io (0, 16): in O = S[L].L16[1];
    }
}

net seg[3] {
    route {
        switch (24, 37): N.L4[1] = SE.DO[3];
        switch (20, 37): N.L16[0] = S.L4[1];
        switch (4, 37): N.L4[0] = S.L16[0];
        switch (0, 37): W.L4[0] = S.L4[0];
        switch (0, 33): W.L4[0] = E.L4[0];
        io (0, 32): in O = S[L].L4[2];
    }
}

net seg[4] {
    route {
        switch (26, 37): S.L1[1] = NE.DO[4];
        switch (27, 37): W.L1[5] = N.L1[1];
        switch (27, 36): S.L1[4] = E.L1[5];
        switch (28, 36): S.L16[0] = N.L1[4];
        switch (44, 36): S.L4[0] = N.L16[0];
        switch (48, 36): E.L16[0] = N.L4[0];
        io (49, 48): in O = N[R].L16[1];
    }
}

net seg[5] {
    route {
        switch (25, 37): W.L1[0] = SE.DO[5];
        switch (25, 36): N.L1[4] = E.L1[0];
        switch (24, 36): N.L16[0] = S.L1[4];
        switch (8, 36): N.L4[0] = S.L16[0];
        switch (4, 36): N.L4[0] = S.L4[0];
        switch (0, 36): E.L16[0] = S.L4[0];
        io (0, 48): in O = S[R].L16[1];
    }
}

net seg[6] {
    route {
        switch (26, 38): E.L4[1] = NW.DO[6];
        switch (26, 42): E.L1[4] = W.L4[1];
        switch (26, 43): E.L1[4] = W.L1[4];
        switch (26, 44): E.L16[0] = W.L1[4];
        switch (26, 60): E.L4[0] = W.L16[0];
        switch (26, 64): N.L1[0] = W.L4[0];
        io (26, 65): in O = W[U].L1[0];
    }
}
